# ====================================================================
# Fuel Gain Tracker - Environment Variables Template (.env)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or secrets to version control.
# ====================================================================

# --------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# --------------------------------------------------------------------
# 2. GOOGLE OAUTH CLIENT CONFIGURATION
# Obtain these from: Google Cloud Console -> APIs & Services -> Credentials
# --------------------------------------------------------------------
VITE_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# --------------------------------------------------------------------
# 3. BACKEND API ENDPOINT CONFIGURATION
# ASP.NET Core 9 API Backend Server URL
# --------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
